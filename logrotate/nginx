/srv/logs/nginx/access.log
/srv/logs/nginx/error.log {
  rotate 7
  daily
  size=10M
  copytruncate
  missingok
  notifempty
  compress
  delaycompress
  sharedscripts
  postrotate
    # The web server container is `main-site-<host>` (renamed from `nginx-<host>`).
    # Both names are matched so hosts not yet renamed keep working.
    docker inspect -f '{{ .State.Pid }}' $(docker ps --filter "name=^/(main-site|nginx)-" --quiet) | xargs -r kill -USR1
  endscript
}

/srv/logs/nginx-proxy-manager/fallback_*.log
/srv/logs/nginx-proxy-manager/proxy-host-*.log {
  rotate 7
  daily
  size=10M
  copytruncate
  missingok
  notifempty
  compress
  delaycompress
}
